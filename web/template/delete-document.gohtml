{{ template "page" . }}

{{ define "main" }}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            {{ template "DeleteDocumentConfirm" . }}
        </div>
    </div>
{{ end }}

{{ define "partial-content" }}
    <div id="document-panel">
        {{ template "DeleteDocumentConfirm" . }}
    </div>
{{ end }}

{{ define "DeleteDocumentConfirm" }}
    <div class="govuk-body">
        {{ range .Document.CaseItems }}{{ template "CaseLabel" . }}{{ end }}
        <h1 class="govuk-heading-m">
            Are you sure you want to delete: <br>
            {{ (parseAndFormatDate .Document.CreatedDate "02/01/2006 15:04:05" "02/01/2006") }} {{ .Document.FriendlyDescription }}?
        </h1>
    </div>

    <iframe class="document-viewer-container" title="Document viewer"
            src="/lpa-api/v1/documents/{{ .Document.UUID }}/file"></iframe>

    <form class="form"
          hx-post="{{ prefix (printf "/delete-document/%s" .Document.UUID) }}"
          hx-target="#document-panel"
          hx-swap="innerHTML">
        <input type="hidden" name="xsrfToken" value="{{ .XSRFToken }}"/>
        <a class="govuk-button govuk-button--secondary"
           href="{{ prefix (printf "/view-document/%s/%d" .Document.UUID .DonorId) }}"
           hx-get="{{ prefix (printf "/view-document/%s/%d" .Document.UUID .DonorId) }}"
           hx-target="#document-panel" hx-swap="innerHTML">
            No, cancel
        </a>
        <button class="govuk-button govuk-button--warning" data-module="govuk-button" type="submit">
            Yes, delete
        </button>
    </form>
{{ end }}
