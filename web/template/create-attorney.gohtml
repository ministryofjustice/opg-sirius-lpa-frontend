{{ template "page" . }}

{{ define "partial-content" }}
  <div class="action-panel__form">

    {{ if .HtmxRedirect }}
        <span class="govuk-!-display-none"
              hx-get="{{ prefix .HtmxRedirect }}"
              hx-target=".action-panel__content"
              hx-swap="{{ .HtmxSwap }}"
              hx-trigger="load"
        ></span>
    {{ end }}

    {{ template "error-summary" .Error }}

    {{ if eq .CaseType "epa" }}
      <a class="govuk-back-link"
         href=""
         hx-get="{{ prefix (printf "/create-epa?id=%d&caseId=%d#accordion-create-epa-heading-3" .DonorId .CaseId) }}"
         hx-target=".action-panel__content"
         hx-swap="innerHTML show:#accordion-create-epa-heading-3:top">Back</a>
    {{ else }}
      <a class="govuk-back-link"
         href=""
         hx-get="{{ prefix (printf "/create-lpa?id=%d&caseId=%d#scroll-to-attorneys" .DonorId .CaseId) }}"
         hx-target=".action-panel__content"
         hx-swap="innerHTML show:#scroll-to-attorneys:top">Back</a>
    {{ end }}

    <h1 class="govuk-heading-m">{{ .Title }}</h1>
    {{ if and (not .IsEditing) (eq .CaseType "lpa") (eq .CaseSubType "pfa") }}
      <div class="govuk-button-group govuk-button-group--row">
        <a class="govuk-link govuk-link--no-visited-state"
           href=""
           hx-get="{{ prefix (printf "/create-trust-corporation?id=%d&caseId=%d" .DonorId .CaseId) }}"
           hx-target=".action-panel__content"
           hx-swap="innerHTML scroll:.action-panel__content:top">Add a trust corporation as an attorney</a>
      </div>
    {{ end }}

    <form class="form"
          method="POST"
          hx-post={{ if .IsEditing }}"{{ prefix (printf "/create-attorney?id=%d&caseId=%d&caseType=%s&attorneyId=%d" .DonorId .CaseId .CaseType .Attorney.ID) }}"{{ else }}"{{ prefix (printf "/create-attorney?id=%d&caseId=%d&caseType=%s" .DonorId .CaseId .CaseType) }}"{{ end }}
          hx-target=".action-panel__content"
          hx-swap="innerHTML">

      {{ template "form-content" . }}

      <div class="govuk-button-group govuk-!-padding-top-5">
          <button class="govuk-button" data-module="govuk-button" type="submit">Save</button>
          {{ if not .IsEditing }}
            <input class="govuk-button" data-module="govuk-button" type="submit" name="add-another" value="Save and add another attorney" />
          {{ end }}
          {{ if ne .NextAttorneyId 0 }}
            <input class="govuk-button" data-module="govuk-button" type="submit" name="next-attorney" value="Save and update next attorney" />
          {{ end }}

          {{ if eq .CaseType "epa" }}
            <a class="govuk-link govuk-link--no-visited-state"
               href=""
               hx-get="{{ prefix (printf "/create-epa?id=%d&caseId=%d#accordion-create-epa-heading-3" .DonorId .CaseId) }}"
               hx-target=".action-panel__content"
               hx-swap="innerHTML show:#accordion-create-epa-heading-3:top">Cancel</a>
          {{ else }}
            <a class="govuk-link govuk-link--no-visited-state"
               href=""
               hx-get="{{ prefix (printf "/create-lpa?id=%d&caseId=%d#scroll-to-attorneys" .DonorId .CaseId) }}"
               hx-target=".action-panel__content"
               hx-swap="innerHTML show:#scroll-to-attorneys:top">Cancel</a>
          {{ end }}
      </div>
    </form>
  </div>
{{ end }}

{{ define "title" }}{{ if .Error.Any }}Error: {{ end }}{{ .Title }}{{ end }}

{{ define "main" }}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ template "error-summary" .Error }}

      {{ if eq .CaseType "epa" }}
        <a href="{{ prefix (printf "/create-epa?id=%d&caseId=%d#accordion-create-epa-heading-3" .DonorId .CaseId) }}" class="govuk-back-link">Back</a>
      {{ else }}
        <a href="{{ prefix (printf "/create-lpa?id=%d&caseId=%d#scroll-to-attorneys" .DonorId .CaseId) }}" class="govuk-back-link">Back</a>
      {{ end }}

      <h1 class="govuk-heading-l">{{ .Title }}</h1>

      {{ if and (not .IsEditing) (eq .CaseType "lpa") (eq .CaseSubType "pfa") }}
        <div class="govuk-button-group govuk-button-group--row">
          <a class="govuk-link govuk-link--no-visited-state" href="{{ prefix (printf "/create-trust-corporation?id=%d&caseId=%d" .DonorId .CaseId) }}">
            Add a trust corporation as an attorney
          </a>
        </div>
      {{ end }}

      <form class="form" method="POST">

        {{ template "form-content" . }}

        <div class="govuk-button-group govuk-!-padding-top-5">
          <button class="govuk-button" data-module="govuk-button" type="submit">Save</button>
          {{ if not .IsEditing }}
            <input class="govuk-button" data-module="govuk-button" type="submit" name="add-another" value="Save and add another attorney" />
          {{ end }}
          {{ if ne .NextAttorneyId 0 }}
            <input class="govuk-button" data-module="govuk-button" type="submit" name="next-attorney" value="Save and update next attorney" />
          {{ end }}

          {{ if eq .CaseType "epa" }}
            <a class="govuk-link govuk-link--no-visited-state" href="{{ prefix (printf "/create-epa?id=%d&caseId=%d#accordion-create-epa-heading-3" .DonorId .CaseId) }}">Cancel</a>
          {{ else }}
            <a class="govuk-link govuk-link--no-visited-state" href="{{ prefix (printf "/create-lpa?id=%d&caseId=%d#scroll-to-attorneys" .DonorId .CaseId) }}">Cancel</a>
          {{ end }}
        </div>
      </form>
    </div>
  </div>
{{ end }}

{{ define "form-content" }}
  <input type="hidden" name="xsrfToken" value="{{ .XSRFToken }}"/>

  {{ if eq .CaseType "lpa" }}
    <div class="app-lpa__radios--border-bottom">
      {{ template "radios" (radios "isAttorneyActive" "Active?" (stringifyBoolPointer .Attorney.SystemStatus) .Error.Field.SystemStatus true
      (item "true" "Yes")
      (item "false" "No")
      ) }}
    </div>
  {{ end }}

  {{ template "input" (field "salutation" "Title" .Attorney.Salutation .Error.Field.salutation) }}
  {{ template "input" (field "firstname" "First name" .Attorney.Firstname .Error.Field.firstname) }}
  {{ template "input" (field "middlenames" "Middle names" .Attorney.Middlenames .Error.Field.middlenames) }}
  {{ template "input" (field "surname" "Last name" .Attorney.Surname .Error.Field.surname) }}
  {{ template "input-date" (field "dob" "Date of birth" .Attorney.DateOfBirth .Error.Field.dob "max" today) }}

  {{ if eq .CaseType "epa" }}
    {{ template "input" (field "companyName" "Company name" .Attorney.CompanyName .Error.Field.companyName) }}
  {{ end }}

  <div class="govuk-form-group" data-module="app-address-finder" data-app-address-finder-label="Address" data-app-address-finder-fill-country="false">
      {{ template "input" (field "addressLine1" "Address line 1" .Attorney.AddressLine1 .Error.Field.addressLine1 "data-app-address-finder-map" "addressLine1") }}
      {{ template "input" (field "addressLine2" "Address line 2" .Attorney.AddressLine2 .Error.Field.addressLine2 "data-app-address-finder-map" "addressLine2") }}
      {{ template "input" (field "addressLine3" "Address line 3" .Attorney.AddressLine3 .Error.Field.addressLine3 "data-app-address-finder-map" "addressLine3") }}
      {{ template "input" (field "town" "Town" .Attorney.Town .Error.Field.town "data-app-address-finder-map" "town" "class" "govuk-!-width-two-thirds") }}
      {{ template "input" (field "county" "County" .Attorney.County .Error.Field.county) }}
      {{ template "input" (field "postcode" "Postcode" .Attorney.Postcode .Error.Field.postcode "data-app-address-finder-map" "postcode" "class" "govuk-!-width-two-thirds") }}
      {{ template "input" (field "country" "Country" .Attorney.Country .Error.Field.country "data-app-address-finder-map" "country") }}

      {{ template "radios" (radios "isAirmailRequired" "Airmail required" ( stringifyBool .Attorney.IsAirmailRequired) .Error.Field.isAirmailRequired true
      (item "true" "Yes")
      (item "false" "No")
      ) }}
  </div>

  {{ template "input" (field "phoneNumber" "Telephone number" .Attorney.PhoneNumber .Error.Field.phoneNumber) }}
  {{ template "input" (field "email" "Email address" .Attorney.Email .Error.Field.email) }}

  {{ if eq .CaseType "epa" }}
    {{ template "select" (select "relationshipToDonor" "Relationship to donor" .Attorney.RelationshipToDonor .Error.Field.relationshipToDonor (options .RelationshipToDonors)) }}
    {{ template "radios" (radios "isAttorneyActive" "Is this attorney active?" (stringifyBoolPointer .Attorney.SystemStatus) .Error.Field.SystemStatus true
    (item "true" "Yes")
    (item "false" "No")
    ) }}
  {{ end }}
{{ end }}
