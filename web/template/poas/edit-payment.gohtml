{{ template "page" . }}

{{ define "partial-content" }}
    <div class="action-panel__form">
        {{ template "case-details" . }}

        {{ template "error-summary" .Error }}

        {{ if .HtmxRedirect }}
            <span class="govuk-!-display-none"
                  hx-get="{{ prefix .HtmxRedirect }}"
                  hx-target=".action-panel__content"
                  hx-swap="innerHTML"
                  hx-trigger="load"
            ></span>
        {{ end }}

        <h1 class="govuk-heading-m">Edit payment</h1>

        <form class="form"
              method="POST"
              hx-post="{{ prefix (printf "/edit-payment?id=%d" .PaymentID) }}"
              hx-target=".action-panel__content"
              hx-swap="innerHTML">
            <input type="hidden" name="xsrfToken" value="{{ .XSRFToken }}"/>
            <input type="hidden" name="id" value="{{ .PaymentID }}"/>

            {{ template "form-content" . }}

            <div class="govuk-button-group govuk-!-padding-top-6">
                <button class="govuk-button" data-module="govuk-button" type="submit">Save</button>
                <a class="govuk-link govuk-link--no-visited-state"
                   href=""
                   hx-get="{{ prefix .ReturnUrl }}"
                   hx-target=".action-panel__content"
                   hx-swap="innerHTML">Cancel</a>
            </div>
        </form>
    </div>
{{ end }}


{{ define "title" }}{{ if .Error.Any }}Error: {{ end }}Edit payment{{ end }}

{{ define "main" }}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            {{ template "case-details" . }}

            {{ template "error-summary" .Error }}

            <h1 class="govuk-heading-l">Edit payment</h1>

            <form class="form" method="POST">
                <input type="hidden" name="xsrfToken" value="{{ .XSRFToken }}"/>

                {{ template "form-content" . }}

                <div class="govuk-button-group govuk-!-padding-top-6">
                    <button class="govuk-button" data-module="govuk-button" type="submit">Save</button>
                    <a class="govuk-link govuk-link--no-visited-state" href="{{ prefix .ReturnUrl }}">Cancel</a>
                </div>
            </form>

        </div>
    </div>
{{ end }}

{{ define "form-content" }}
    <div class="govuk-form-group {{ if .Error.Field.amount }}govuk-form-group--error{{ end }}">
        <h3 class="govuk-label-wrapper">
            <label class="govuk-label" for="f-amount">
                Enter amount paid
            </label>
        </h3>
        {{ template "errors" .Error.Field.amount }}
        <div class="govuk-input__wrapper">
            <div class="govuk-input__prefix" aria-hidden="true">£</div>
            <input class="govuk-input govuk-input--width-5 {{ if .Error.Field.amount }}govuk-input--error{{ end }}"
                   id="f-amount" name="amount" type="number" step="0.01"
                   value="{{ if ne .Amount "0" }}{{ .Amount }}{{ end }}">
        </div>
    </div>

    <div class="govuk-form-group {{ if .Error.Field.source }}govuk-form-group--error{{ end }}">
        <fieldset class="govuk-fieldset">
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Payment method</legend>
            {{ template "errors" .Error.Field.source }}
            <div class="govuk-radios govuk-radios--small" data-module="govuk-radios">
                {{ range $i, $paymentSource := .PaymentSources }}
                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input" id="f-{{ fieldID "source" $i }}" name="source" type="radio" value="{{ $paymentSource.Value }}" {{ if eq $.Source $paymentSource.Value }}checked{{ end }}>
                        <label class="govuk-label govuk-radios__label" for="f-{{ fieldID "source" $i }}">{{ $paymentSource.Label }}</label>
                    </div>
                {{ end }}
            </div>
        </fieldset>
    </div>

    {{ template "input-date" (field "paymentDate" "Date of payment" .PaymentDate .Error.Field.paymentDate "max" today "selectToday" true) }}
{{ end }}
