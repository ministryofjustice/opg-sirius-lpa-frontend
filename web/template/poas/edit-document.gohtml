{{ template "page" . }}

{{ define "partial-content" }}
    <div class="action-panel__form action-panel__form--wide">
        {{ template "error-summary" .Error }}

        {{ if .Success }}
            {{ template "success-banner" "Draft document published" }}
            <meta http-equiv="Refresh" content="0" />
        {{ else if .SaveAndExit }}
            <meta http-equiv="Refresh" content="0" />
        {{ else if .PreviewDraft }}
            <a href="{{ sirius (printf "/lpa-api/v1/documents/%s/download" .DownloadUUID) }}" target="_blank"
                data-module="app-auto-click">Download preview document</a>
        {{ end }}

        {{ if .CaseSummary.DigitalLpa.SiriusData.ID }}
            {{ template "mlpa-header" (caseTabs .CaseSummary "documents") }}

            <div class="govuk-body">
                <a href="{{ prefix (printf "/lpa/%s/documents" .CaseSummary.DigitalLpa.UID) }}" class="govuk-back-link govuk-!-margin-top-0 govuk-!-margin-bottom-0">
                Back
                </a>
            </div>

            <h1 class="govuk-heading-l">Edit draft document</h1>
        {{ else }}
            <div class="govuk-body">
            <a class="govuk-back-link govuk-!-margin-top-0 govuk-!-margin-bottom-0"
                href=""
                hx-get="{{ prefix (printf "/action-panel?donorId=%d&entity=%s&uid[]=%s" .DonorId (ToLower .Case.CaseType) .Case.UID) }}"
                hx-target=".action-panel__content"
            >Back</a>
            <div class="app-!-float-right">
                {{ subtypeShortFormat .Case.SubType }} {{ .Case.UID }}
            </div>
            </div>

            <h1 class="govuk-heading-m">Edit draft document</h1>
        {{ end }}

        {{ if not .Documents }}
            <span class="govuk-!-display-none"
                hx-get="{{ prefix (printf "/action-panel?donorId=%d&entity=%s&uid[]=%s" .DonorId (ToLower .Case.CaseType) .Case.UID) }}"
                hx-target=".action-panel__content"
                hx-swap="innerHTML"
                hx-trigger="load"
            ></span>
        {{ else }}
            <form class="form"
                method="GET"
                hx-get="{{ prefix (printf "/edit-document?id=%d&case=%s" .Case.ID (ToLower .Case.CaseType)) }}"
                hx-target=".action-panel__content"
                hx-swap="innerHTML"
            >
                {{ template "select-draft-form-content" . }}
            </form>
            <form class="form"
                    method="POST"
                    hx-post="{{ prefix (printf "/edit-document?id=%d&case=%s" .Case.ID (ToLower .Case.CaseType)) }}"
                    hx-target=".action-panel__content"
                    hx-swap="innerHTML"
            >
                {{ template "edit-text-form-content" . }}
            </form>
            <div class="govuk-body">
                <a class="govuk-link govuk-link--no-visited-state"
                    href=""
                    hx-get="{{ prefix (printf "/action-panel?donorId=%d&entity=%s&uid[]=%s" .DonorId (ToLower .Case.CaseType) .Case.UID) }}"
                    hx-target=".action-panel__content"
                >Cancel</a>
            </div>
        {{ end }}
    </div>
{{ end }}

{{ define "title" }}{{ if .Error.Any }}Error: {{ end }}Edit Document{{ end }}

{{ define "main" }}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            {{ template "error-summary" .Error }}

            {{ if .Success }}
                <meta data-app-reload="reload-timeline"/>
                {{ template "success-banner" "Draft document published" }}
            {{ else if .SaveAndExit }}
                <meta data-app-reload="saveAndExit"/>
            {{ else if .PreviewDraft }}
                <a href="{{ sirius (printf "/lpa-api/v1/documents/%s/download" .DownloadUUID) }}" target="_blank"
                   data-module="app-auto-click">Download preview document</a>
            {{ end }}

            {{ if .CaseSummary.DigitalLpa.SiriusData.ID }}
                {{ template "mlpa-header" (caseTabs .CaseSummary "documents") }}

                <div class="govuk-body">
                    <a href="{{ prefix (printf "/lpa/%s/documents" .CaseSummary.DigitalLpa.UID) }}" class="govuk-back-link govuk-!-margin-top-0 govuk-!-margin-bottom-0">
                        Back
                    </a>
                </div>

                <h1 class="govuk-heading-l">Edit draft document</h1>
            {{ else }}
                <div class="govuk-body">
                    <a href="{{ prefix (printf "/create-document?id=%d&case=%s" .Case.ID .Case.CaseType) }}" class="govuk-back-link govuk-!-margin-top-0 govuk-!-margin-bottom-0" data-app-iframe-cancel>
                        Back
                    </a>
                    <div class="app-!-float-right">
                        {{ subtypeShortFormat .Case.SubType }} {{ .Case.UID }}
                    </div>
                </div>

                <h1 class="govuk-heading-m">Edit draft document</h1>
            {{ end }}

            {{ if not .Documents }}
                <meta data-app-reload="saveAndExit"/>
            {{ else }}
                <form class="form" method="GET">
                    {{ template "select-draft-form-content" . }}
                </form>
                <form class="form" method="POST">
                    {{ template "edit-text-form-content" . }}
                </form>
                <div class="govuk-body">
                    <a class="govuk-link govuk-link--no-visited-state"
                        href="{{ prefix (printf "/lpa/%s/documents" .Case.UID )}}"
                        data-app-iframe-cancel
                >Cancel</a>
    </div>
            {{ end }}
        </div>
    </div>
{{ end }}

{{ define "select-draft-form-content"}}
    <input type="hidden" name="id" value="{{ .Case.ID }}"/>
    <input type="hidden" name="case" value="{{ .Case.CaseType }}"/>

    <div class="govuk-form-group {{ if .Error.Field.document }}govuk-form-group--error{{ end }} govuk-!-margin-bottom-0">
        <label class="govuk-label" for="f-document">
            Select a draft to edit
        </label>
        {{ template "errors" .Error.Field.document }}
        <div class="app-!-flex">
            <select class="govuk-select {{ if .Error.Field.document }}govuk-select--error{{ end }} app-!-full-width govuk-!-margin-right-2"
                    id="f-document" name="document">
                <option hidden {{ if not nil }}selected{{ end }} disabled></option>
                {{ $documentID := .Document.ID }}
                {{ range .Documents }}
                    <option value="{{ .UUID }}" {{ if eq .ID $documentID }}selected{{ end }}>{{ .ID }}: {{ .CreatedDate }}: {{ .Correspondent.Firstname }} {{ .Correspondent.Surname }}: {{ .SystemType }}</option>
                {{ end }}
            </select>
            <button class="govuk-button govuk-button--secondary"
                    data-module="govuk-button" type="submit">Select
            </button>
        </div>
    </div>
{{ end }}

{{ define "edit-text-form-content"}}
    <input type="hidden" name="xsrfToken" value="{{ .XSRFToken }}"/>
    <input type="hidden" name="id" value="{{ .Case.ID }}"/>
    <input type="hidden" name="case" value="{{ .Case.CaseType }}"/>
    <input type="hidden" name="documentUUID" value="{{ .Document.UUID }}"/>

    <div class="govuk-form-group {{ if .Error.Field.documentTextEditor }}govuk-form-group--error{{ end }} govuk-!-margin-bottom-3">
        <textarea id="documentTextEditor" name="documentTextEditor">{{ filterContent .Document.Content }}</textarea>
    </div>

    {{ if and (eq .Case.CaseType "LPA") (eq .BlankSectionsEnabled true) }}
      <div class="govuk-form-group">
        <fieldset class="govuk-fieldset" aria-describedby="contact-hint">
          <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
            <div class="govuk-checkboxes__item">
              <input class="govuk-checkboxes__input" id="insert-blank-sections" name="hasBlankSections" type="checkbox" value="true" data-aria-controls="blank-sections-conditional"{{if eq .HasBlankSections "true"}} checked{{end}}>
              <label class="govuk-label govuk-checkboxes__label" for="insert-blank-sections">
                <span class="app-colour-link-blue">Insert blank sections of the LPA</span>
              </label>
            </div>
            <div class="govuk-checkboxes__conditional govuk-checkboxes__conditional--hidden" id="blank-sections-conditional">
              <div class="govuk-form-group">
                <fieldset class="govuk-fieldset">
                  <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">
                    Choose sections to insert
                  </legend>
                  {{ template "errors" .Error.Field.blankSections }}
                  <div class="govuk-radios govuk-radios--small{{ if .Error.Field.blankSections }} govuk-radios--error{{ end }}" data-module="govuk-radios">
                    <div class="govuk-radios__item">
                      <input class="govuk-radios__input" id="f-blankSections" name="blankSections" type="radio" value="15"{{if eq .SelectedBlankSections "15"}} checked{{end}}>
                      <label class="govuk-label govuk-radios__label" for="f-blankSections">
                        Section 15
                      </label>
                    </div>
                    <div class="govuk-radios__item">
                      <input class="govuk-radios__input" id="f-blankSections-2" name="blankSections" type="radio"
                             value="11+15" data-aria-controls="11+15-conditional"{{if eq .SelectedBlankSections "11+15"}} checked{{end}}>
                      <label class="govuk-label govuk-radios__label" for="f-blankSections-2">
                        Section 11 + 15
                      </label>
                    </div>
                    <div class="govuk-radios__conditional govuk-radios__conditional--hidden" id="11+15-conditional">
                      <div class="govuk-form-group">
                        <fieldset class="govuk-fieldset">
                          <div class="govuk-hint">
                            How many section 11?
                          </div>
                          {{ template "errors" .Error.Field.section11Count1 }}
                          <div class="govuk-radios govuk-radios--small govuk-radios--inline{{ if .Error.Field.section11Count1 }} govuk-radios--error{{ end }}" data-module="govuk-radios">
                            {{ range .AttorneyCount }}
                              {{ $count := plusN . 1 }}
                              <div class="govuk-radios__item">
                                <input class="govuk-radios__input" id="f-section11Count1-{{$count}}" name="section11Count1" type="radio"
                                       value="{{$count}}"{{if or (eq $.Section11Count1 (printf "%d" $count)) (eq $.AttorneyCount 1)}} checked{{end}}>
                                <label class="govuk-label govuk-radios__label" for="section11Count1-{{$count}}">{{$count}}</label>
                              </div>
                            {{ end }}
                          </div>
                        </fieldset>
                      </div>
                    </div>
                    <div class="govuk-radios__item">
                      <input class="govuk-radios__input" id="f-blankSections-3" name="blankSections" type="radio"
                             value="10+11+15" data-aria-controls="10+11+15-conditional"{{if eq .SelectedBlankSections "10+11+15"}} checked{{end}}>
                      <label class="govuk-label govuk-radios__label" for="f-blankSections-3">
                        Section 10 + 11 + 15
                      </label>
                    </div>
                    <div class="govuk-radios__conditional govuk-radios__conditional--hidden" id="10+11+15-conditional">
                      <div class="govuk-form-group">
                        <fieldset class="govuk-fieldset">
                          <div class="govuk-hint">
                            How many section 11?
                          </div>
                          {{ template "errors" .Error.Field.section11Count2 }}
                          <div class="govuk-radios govuk-radios--small govuk-radios--inline{{ if .Error.Field.section11Count2 }} govuk-radios--error{{ end }}" data-module="govuk-radios">
                            {{ range .AttorneyCount }}
                              {{ $count := plusN . 1 }}
                              <div class="govuk-radios__item">
                                <input class="govuk-radios__input" id="f-section11Count2-{{$count}}" name="section11Count2" type="radio"
                                       value="{{$count}}"{{if or (eq $.Section11Count2 (printf "%d" $count)) (and (eq $.Section11Count2 "") (eq $count $.AttorneyCount ))}} checked{{end}}>
                                <label class="govuk-label govuk-radios__label" for="f-section11Count2-{{$count}}">{{$count}}</label>
                              </div>
                            {{ end }}
                          </div>
                        </fieldset>
                      </div>
                    </div>
                    <div class="govuk-radios__item">
                      <input class="govuk-radios__input" id="f-blankSections-4" name="blankSections" type="radio"
                             value="12+13+15"{{if eq .SelectedBlankSections "12+13+15"}} checked{{end}}>
                      <label class="govuk-label govuk-radios__label" for="f-blankSections-4">
                        Section 12 + 13 + 15
                      </label>
                    </div>
                  </div>
                </fieldset>
              </div>
            </div>
          </div>
        </fieldset>
      </div>
    {{ end }}

    {{ if .UsesNotify }}
        <div class="govuk-notification-banner govuk-!-margin-bottom-3" role="region" aria-labelledby="notify-warning" data-module="govuk-notification-banner">
            <div class="govuk-notification-banner__header">
                <h2 class="govuk-notification-banner__title" id="notify-warning">
                    Warning
                </h2>
            </div>
            <div class="govuk-notification-banner__content">
                When you publish this letter it will automatically be sent via GOV.UK Notify
            </div>
        </div>
    {{ end }}

    <div class="govuk-button-group {{ if .IsPartial }}govuk-button-group--row{{ end }}">
        <button class="govuk-button govuk-button--secondary" data-module="govuk-button" name="documentControls" type="submit" value="save">Save draft</button>
        <button class="govuk-button govuk-button--secondary" data-module="govuk-button" name="documentControls" type="submit" value="saveAndExit" id="saveAndExit">Save and exit</button>
        <button class="govuk-button govuk-button--secondary" data-module="govuk-button" name="documentControls" type="submit" value="delete">Delete draft</button>
        <button class="govuk-button govuk-button--secondary" data-module="govuk-button" name="documentControls" type="submit" value="preview">Preview draft</button>
        <button class="govuk-button" data-module="govuk-button" name="documentControls" type="submit" value="publish">{{ if .UsesNotify }}Publish and Send{{ else }}Publish draft{{ end }}</button>
    </div>
{{ end }}
