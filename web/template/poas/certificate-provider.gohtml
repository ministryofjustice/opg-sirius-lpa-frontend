{{ template "page" . }}

{{ define "partial-content" }}
    <div class="action-panel__form">

        {{ if .HtmxRedirect }}
            <span class="govuk-!-display-none"
                  hx-get="{{ prefix .HtmxRedirect }}"
                  hx-target=".action-panel__content"
                  hx-trigger="load"
                  hx-swap="{{ .HtmxSwap }}"
            ></span>
        {{ end }}

        {{ template "error-summary" .Error }}

        <a class="govuk-back-link"
           href=""
           hx-get="{{ prefix .PostURL }}"
           hx-target=".action-panel__content"
           hx-swap="innerHTML show:#accordion-create-lpa-heading-3:top">Back</a>

        <h1 class="govuk-heading-m">{{ .Title }}</h1>

        <form class="form"
              method="POST"
              hx-post="{{ prefix .PostURL }}"
              hx-target=".action-panel__content"
              hx-swap="innerHTML">

            {{ template "form-content" . }}

            <div class="govuk-button-group govuk-!-padding-top-5">
                <button class="govuk-button" data-module="govuk-button" type="submit">Save</button>
                {{ if .CanAddActor }}
                    <input class="govuk-button" data-module="govuk-button" type="submit" name="add-another" value="Save and add a second certificate provider" />
                {{ end }}
                <a class="govuk-link govuk-link--no-visited-state"
                   href=""
                   hx-get="{{ prefix (printf "/create-lpa?id=%d&caseId=%d#accordion-create-lpa-heading-3" .DonorId .CaseId) }}"
                   hx-target=".action-panel__content"
                   hx-swap="innerHTML show:#accordion-create-lpa-heading-3:top">Cancel</a>
            </div>
        </form>
    </div>
{{ end }}

{{ define "title" }}{{ if .Error.Any }}Error: {{ end }}{{ .Title }}{{ end }}

{{ define "main" }}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            {{ template "error-summary" .Error }}

            <a href="{{ prefix (printf "/create-lpa?id=%d&caseId=%d#accordion-create-lpa-heading-3" .DonorId .CaseId) }}" class="govuk-back-link">Back</a>

            <h1 class="govuk-heading-l">{{ .Title }}</h1>

            <form class="form" method="POST">

                {{ template "form-content" . }}

                <div class="govuk-button-group govuk-!-padding-top-5">
                    <button class="govuk-button" data-module="govuk-button" type="submit">Save</button>
                    {{ if .CanAddActor }}
                        <input class="govuk-button" data-module="govuk-button" type="submit" name="add-another" value="Save and add a second certificate provider" />
                    {{ end }}
                    <a class="govuk-link govuk-link--no-visited-state" href="{{ prefix (printf "/create-lpa?id=%d&caseId=%d#accordion-create-lpa-heading-3" .DonorId .CaseId) }}">Cancel</a>
                </div>
            </form>
        </div>
    </div>
{{ end }}

{{ define "form-content" }}
    <input type="hidden" name="xsrfToken" value="{{ .XSRFToken }}"/>
    {{ template "input" (field "salutation" "Title" .CertificateProvider.Salutation .Error.Field.salutation) }}
    {{ template "input" (field "firstname" "First name" .CertificateProvider.Firstname .Error.Field.firstname) }}
    {{ template "input" (field "middlenames" "Middle names" .CertificateProvider.Middlenames .Error.Field.middlenames) }}
    {{ template "input" (field "surname" "Last name" .CertificateProvider.Surname .Error.Field.surname) }}

    <div class="govuk-form-group" data-module="app-address-finder" data-app-address-finder-label="Address" data-app-address-finder-fill-country="false">
        {{ template "input" (field "addressLine1" "Address line 1" .CertificateProvider.AddressLine1 .Error.Field.addressLine1 "data-app-address-finder-map" "addressLine1") }}
        {{ template "input" (field "addressLine2" "Address line 2" .CertificateProvider.AddressLine2 .Error.Field.addressLine2 "data-app-address-finder-map" "addressLine2") }}
        {{ template "input" (field "addressLine3" "Address line 3" .CertificateProvider.AddressLine3 .Error.Field.addressLine3 "data-app-address-finder-map" "addressLine3") }}
        {{ template "input" (field "town" "Town" .CertificateProvider.Town .Error.Field.town "data-app-address-finder-map" "town" "class" "govuk-!-width-two-thirds") }}
        {{ template "input" (field "county" "County" .CertificateProvider.County .Error.Field.county) }}
        {{ template "input" (field "postcode" "Postcode" .CertificateProvider.Postcode .Error.Field.postcode "data-app-address-finder-map" "postcode" "class" "govuk-!-width-two-thirds") }}
        {{ template "input" (field "country" "Country" .CertificateProvider.Country .Error.Field.country "data-app-address-finder-map" "country") }}
    </div>
{{ end }}