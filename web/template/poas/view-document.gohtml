{{ template "page" . }}
{{ define "main" }}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">
            {{ template "DocumentViewer" . }}
        </div>
    </div>
{{ end }}

{{ define "partial-content" }}
    <div id="document-viewer-content">
        {{ template "DocumentViewer" . }}
    </div>
{{ end }}