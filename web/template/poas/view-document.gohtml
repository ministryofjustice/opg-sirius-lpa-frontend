{{ template "page" . }}

{{ define "container-classes" }} app-!-max-full-width{{ end }}

{{ define "sirius-header" }}
    {{ template "siriusHeader" . }}
{{ end }}

{{ define "action-panel-wrapper" }}
    {{ template "actionPanelWrapper" . }}
{{ end }}

{{ define "main" }}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full" id="document-panel">
            {{ template "documentViewer" . }}
        </div>
    </div>
{{ end }}

{{ define "partial-content" }}
    {{ template "siriusHeader" . }}
    {{ template "documentViewer" . }}
{{ end }}