{{ template "page" . }}

{{ define "title" }}{{ if .Error.Any }}Error: {{ end }}{{ .Title }}{{ end }}

{{ define "main" }}
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            {{ template "error-summary" .Error }}

            <a href="{{ prefix (printf "/create-lpa?id=%d&caseId=%d#accordion-create-lpa-heading-1" .DonorId .CaseId) }}" class="govuk-back-link">Back</a>

            <h1 class="govuk-heading-l">{{ .Title }}</h1>

            {{ if not .IsEditing }}
                <div class="govuk-button-group govuk-button-group--row">
                    <a class="govuk-link govuk-link--no-visited-state" href="{{ prefix (printf "/create-trust-corporation?id=%d&caseId=%d&replacement=true" .DonorId .CaseId) }}">
                        Add a trust corporation as a replacement attorney
                    </a>
                </div>
            {{ end }}

            <form class="form" method="POST">

                {{ template "createReplacementAttorney" . }}

                <div class="govuk-button-group govuk-!-padding-top-5">
                    <button class="govuk-button" data-module="govuk-button" type="submit">Save</button>
                    {{ if not .IsEditing }}
                        <input class="govuk-button" data-module="govuk-button" type="submit" name="add-another" value="Save and add another replacement attorney" />
                    {{ end }}
                    {{ if ne .NextAttorneyId 0 }}
                        <input class="govuk-button" data-module="govuk-button" type="submit" name="next-attorney" value="Save and update next replacement attorney" />
                    {{ end }}
                    <a class="govuk-link govuk-link--no-visited-state" href="{{ prefix (printf "/create-lpa?id=%d&caseId=%d#accordion-create-lpa-heading-1" .DonorId .CaseId) }}">Cancel</a>
                </div>
            </form>
        </div>
    </div>
{{ end }}
