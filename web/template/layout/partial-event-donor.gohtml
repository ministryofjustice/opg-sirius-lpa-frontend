{{ define "partial-event-donor" }}
    {{ $hasChildKey := false }}
    {{ $hasParentKey := false }}
    {{ if eq (len .Changes) 1 }}
        {{ range $key, $v := .Changes }}
            {{ if eq $key "child" }}
                {{ $hasChildKey = true }}
            {{ end }}
            {{ if eq $key "parent" }}
                {{ $hasParentKey = true }}
            {{ end }}
        {{ end }}
    {{ end}}

    {{ if eq .Type "INS" }}
        {{ if or .Entity.firstname .Entity.surname }}
            <p><strong>{{ .Entity.firstname}} {{ .Entity.surname }}</strong></p>
        {{ end }}
    {{ else if eq .Type "UPD" }}
        {{ if $hasParentKey }}
            {{/* This is the child record */}}
            {{ $firstname := index $.Entity "firstname" }}
            {{ $surname := index $.Entity "surname" }}
            {{ $childId := index $.Entity "id" }}

            {{ range $key, $v := .Changes }}
                {{ if isChildLinked $v }}
                    {{/* Linking parent to child event (on child donor)*/}}
                    {{ $identifierMap := index $v "1" }}
                    {{ $parentId := index (index $identifierMap "identifier") "id" }}
                    <p>
                        <a class="govuk-link" href="{{ sirius (printf "/lpa/person/%v" $parentId) }}">Primary record</a>
                        was linked to
                        <a class="govuk-link" href="{{ sirius (printf "/lpa/person/%v" $childId) }}">child record</a>
                    </p>
                {{ else }}
                    {{/* Unlinking parent to child event (on child donor)*/}}
                    {{ $identifierMap := index $v 0 }}
                    {{ $parentId := index (index $identifierMap "identifier") "id" }}
                    <p>
                        <a class="govuk-link" href="{{ sirius (printf "/lpa/person/%v" $childId) }}">{{ $firstname }} {{$surname}}</a>
                        was unlinked from
                        <a class="govuk-link" href="{{ sirius (printf "/lpa/person/%v" $parentId) }}">Primary record</a>
                    </p>
                {{ end }}
            {{ end }}
        {{ else if $hasChildKey }}
            {{/* This is the parent/primary record */}}
            {{ $firstname := index $.Entity "firstname" }}
            {{ $surname := index $.Entity "surname" }}
            {{ $parentId := index $.Entity "id" }}

            {{ range $key, $v := .Changes }}
                {{ if eq (len (index $v 0)) 0 }}
                    {{/* Linking parent to child event (on parent/primary donor */}}
                    {{ $identifierMap := index (index $v 1) 0 }}
                    {{ $childId := index (index $identifierMap "identifier") "id" }}
                    <p>
                        <a class="govuk-link" href="{{ sirius (printf "/lpa/person/%v" $parentId) }}">Primary record</a>
                        was linked to
                        <a class="govuk-link" href="{{ sirius (printf "/lpa/person/%v" $childId) }}">child record</a>
                    </p>
                {{ else if eq (len (index $v 1)) 0 }}
                    {{/* Unlinking parent to child event (on parent/primary donor) */}}
                    {{ $identifierMap := index (index $v 0) 0 }}
                    {{ $childId := index (index $identifierMap "identifier") "id" }}
                    <p>
                        <a class="govuk-link" href="{{ sirius (printf "/lpa/person/%v" $parentId)}}">{{ $firstname }} {{ $surname }}</a>
                        had a
                        <a class="govuk-link" href="{{ sirius (printf "/lpa/person/%v" $childId) }}">child record</a>
                        unlinked
                    </p>
                {{ end }}
            {{ end }}
        {{ else }}
            <ul class="govuk-list">
                {{ range $fieldName := .Context.EventFieldOrder }}
                    {{ $changeValues := index $.Changes $fieldName }}
                    {{ if ne $changeValues nil }}
                        {{ if ne (len $changeValues) 1 }}
                            {{ $oldValue := index $changeValues 0 }}
                            {{ $newValue := index $changeValues 1 }}
                            {{ if eq $fieldName "dob" }}
                                <li>
                                    Date of birth:
                                    {{ parseAndFormatDate $oldValue.date "2006-01-02 00:00:00.000000" "02/01/2006" }}
                                    changed to:
                                    {{ parseAndFormatDate $newValue.date "2006-01-02 00:00:00.000000" "02/01/2006" }}
                                </li>
                            {{ else }}
                                <li>
                                    {{ camelcaseToSentence $fieldName }}:
                                    {{ $oldValue }} changed to: {{ $newValue }}
                                </li>
                            {{ end }}
                        {{ else }} {{/* This is being translated as a map, due to the old value being null, so only indexes "1" */}}
                        {{ $newValue := index $changeValues "1" }}
                        {{ if eq $fieldName "dob" }}
                            <li>Date of birth: {{ parseAndFormatDate $newValue.date "2006-01-02 00:00:00.000000" "02/01/2006" }}</li>
                        {{ else }}
                            {{/* Shouldn't hit this in Donor event but added in case of old events data */}}
                            <li>{{ camelcaseToSentence $fieldName }}: {{ $newValue }}</li>
                        {{ end }}
                        {{ end }}
                    {{ end }}
                {{ end }}
            </ul>
        {{ end }}
    {{ end }}
{{ end }}